<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FootballCompetition.ViewModels"
             xmlns:m="using:FootballCompetition.Models"
             xmlns:s="using:FootballCompetition.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="FootballCompetition.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #15000000"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="32,28">
            <StackPanel Spacing="4" Margin="0,0,0,20">
                <TextBlock Text="Отчеты и запросы" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Шесть отчетов на основе LINQ, поддерживаемых сервисом FootballManagerService."
                           FontSize="13" Foreground="#475569"/>
            </StackPanel>

            <!-- Q1 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="1. Даты матчей и результаты команды"/>
                    <TextBlock Classes="subtitle" Text="Выберите команду для просмотра всех её матчей, соперников и счетов."/>
                    <Grid ColumnDefinitions="*,12,Auto">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Teams}"
                                  SelectedItem="{Binding Q1Team}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Team">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Classes="primary" Content="Запустить" Command="{Binding RunQ1Command}"/>
                    </Grid>
                    <DataGrid Margin="0,12,0,0"
                              ItemsSource="{Binding Q1Results}"
                              IsReadOnly="True"
                              MinHeight="120"
                              MaxHeight="240"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Команда"     Binding="{Binding Team}"     Width="*"/>
                            <DataGridTextColumn Header="Соперник" Binding="{Binding Opponent}" Width="*"/>
                            <DataGridTextColumn Header="Дата"     Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="140"/>
                            <DataGridTextColumn Header="Счет"    Binding="{Binding Score}"    Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Q2 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="2. Игроки в матче (дата + стадион)"/>
                    <TextBlock Classes="subtitle" Text="Возвращает номера и фамилии игроков обеих команд, игравших в выбранный день."/>
                    <Grid ColumnDefinitions="*,12,*,12,Auto">
                        <CalendarDatePicker Grid.Column="0"
                                            SelectedDate="{Binding Q2Date}"
                                            HorizontalAlignment="Stretch"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding Stadiums}"
                                  SelectedItem="{Binding Q2Stadium}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Stadium">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="4" Classes="primary" Content="Запустить" Command="{Binding RunQ2Command}"/>
                    </Grid>
                    <DataGrid Margin="0,12,0,0"
                              ItemsSource="{Binding Q2Results}"
                              IsReadOnly="True"
                              MinHeight="120"
                              MaxHeight="240"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Команда"      Binding="{Binding Team}"     Width="*"/>
                            <DataGridTextColumn Header="#"         Binding="{Binding Number}"   Width="80"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Q3 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="3. Динамическая цена билета для двух команд"/>
                    <TextBlock Classes="subtitle" Text="Топ-3 против топ-3 → максимальная цена. Худшие 3 против худших 3 → минимальная цена. Иначе → средняя."/>
                    <Grid ColumnDefinitions="*,12,*,12,Auto">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Teams}"
                                  SelectedItem="{Binding Q3Team1}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Team">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding Teams}"
                                  SelectedItem="{Binding Q3Team2}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Team">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="4" Classes="primary" Content="Рассчитать" Command="{Binding RunQ3Command}"/>
                    </Grid>
                    <Border Margin="0,12,0,0"
                            Padding="14,10"
                            Background="#EFF6FF"
                            CornerRadius="8">
                        <TextBlock Text="{Binding Q3Result}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Q4 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="4. Лучшая и худшая разница мячей"/>
                    <TextBlock Classes="subtitle" Text="Вычисляется путем анализа результатов всех сыгранных матчей."/>
                    <Button Classes="primary" Content="Запустить" Command="{Binding RunQ4Command}" HorizontalAlignment="Left"/>
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding Q4Headline}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <DataGrid Margin="0,12,0,0"
                              ItemsSource="{Binding Q4Results}"
                              IsReadOnly="True"
                              MinHeight="120"
                              MaxHeight="240"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Команда" Binding="{Binding Team}" Width="*"/>
                            <DataGridTextColumn Header="Разница мячей" Binding="{Binding GoalDifference}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Q5 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="5. Призеры (топ-3 по очкам)"/>
                    <TextBlock Classes="subtitle" Text="Стандартный подсчет очков: победа = 3, ничья = 1, поражение = 0."/>
                    <Button Classes="primary" Content="Запустить" Command="{Binding RunQ5Command}" HorizontalAlignment="Left"/>
                    <DataGrid Margin="0,12,0,0"
                              ItemsSource="{Binding Q5Results}"
                              IsReadOnly="True"
                              MinHeight="120"
                              MaxHeight="240"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Команда"   Binding="{Binding Team}"  Width="*"/>
                            <DataGridTextColumn Header="И"      Binding="{Binding Played}" Width="60"/>
                            <DataGridTextColumn Header="В"      Binding="{Binding Won}"    Width="60"/>
                            <DataGridTextColumn Header="Н"      Binding="{Binding Drawn}"  Width="60"/>
                            <DataGridTextColumn Header="П"      Binding="{Binding Lost}"   Width="60"/>
                            <DataGridTextColumn Header="РМ"     Binding="{Binding GoalDifference}" Width="80"/>
                            <DataGridTextColumn Header="Очки"    Binding="{Binding Points}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Q6 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="6. Расписание матчей, сгруппированное по стадионам"/>
                    <Button Classes="primary" Content="Запустить" Command="{Binding RunQ6Command}" HorizontalAlignment="Left"/>
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Q6Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:StadiumScheduleGroup">
                                <Border Margin="0,0,0,12"
                                        Background="#F8FAFC"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Stadium}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                        <ItemsControl ItemsSource="{Binding Matches}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="s:ScheduledMatchRow">
                                                    <Grid ColumnDefinitions="120,*,Auto" Margin="0,3,0,3">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Date, StringFormat=yyyy-MM-dd}"
                                                                   Foreground="#475569"/>
                                                        <TextBlock Grid.Column="1">
                                                            <Run Text="{Binding Team1}"/>
                                                            <Run Text=" против "/>
                                                            <Run Text="{Binding Team2}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Score}"
                                                                   FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
