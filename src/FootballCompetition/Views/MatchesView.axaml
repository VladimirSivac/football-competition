<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FootballCompetition.ViewModels"
             xmlns:m="using:FootballCompetition.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="FootballCompetition.Views.MatchesView"
             x:DataType="vm:MatchesViewModel">

    <Grid RowDefinitions="Auto,*" Margin="32,28">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Матчи" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Планируйте матчи, фиксируйте итоговые результаты и выбирайте домашний стадион."
                       FontSize="13" Foreground="#475569"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,16,420">
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BoxShadow="0 4 12 0 #15000000">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="Добавить" Command="{Binding NewCommand}"/>
                            <Button Classes="ghost"   Content="Редактировать"      Command="{Binding EditCommand}"/>
                            <Button Classes="danger"  Content="Удалить"    Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Matches}"
                              SelectedItem="{Binding SelectedMatch}"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата"    Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="Команда 1"  Binding="{Binding Team1Name}" Width="*"/>
                            <DataGridTextColumn Header="Команда 2"  Binding="{Binding Team2Name}" Width="*"/>
                            <DataGridTextColumn Header="Счет"   Binding="{Binding Score}"     Width="80"/>
                            <DataGridTextColumn Header="Стадион" Binding="{Binding StadiumName}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    BoxShadow="0 4 12 0 #15000000">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Детали матча"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding !IsEditing}"
                                Spacing="6">
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="{Binding SelectedMatch.Team1Name, FallbackValue='—'}"/>
                            <Run Text=" против "/>
                            <Run Text="{Binding SelectedMatch.Team2Name, FallbackValue='—'}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Дата: "/>
                            <Run Text="{Binding SelectedMatch.Date, StringFormat=yyyy-MM-dd}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Стадион: "/>
                            <Run Text="{Binding SelectedMatch.StadiumName}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Итоговый счет: "/>
                            <Run Text="{Binding SelectedMatch.Score}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding IsEditing}"
                                Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Команда 1 (хозяева)" FontSize="12" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding Teams}"
                                      SelectedItem="{Binding DraftTeam1}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Team">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Команда 2 (гости)" FontSize="12" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding Teams}"
                                      SelectedItem="{Binding DraftTeam2}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Team">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Стадион" FontSize="12" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding Stadiums}"
                                      SelectedItem="{Binding DraftStadium}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Stadium">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Дата" FontSize="12" Foreground="#475569"/>
                            <CalendarDatePicker SelectedDate="{Binding DraftDate}"
                                                HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Счет (например, 2:1, оставьте пустым, если не сыгран)"
                                       FontSize="12" Foreground="#475569"/>
                            <TextBox Text="{Binding Draft.Score}" PlaceholderText="2:1"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Classes="primary" Content="Сохранить"   Command="{Binding SaveCommand}"/>
                            <Button Classes="ghost"   Content="Отмена" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
