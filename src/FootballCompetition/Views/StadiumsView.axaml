<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FootballCompetition.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="FootballCompetition.Views.StadiumsView"
             x:DataType="vm:StadiumsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="32,28">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Stadiums" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Capacity and base ticket price feed the dynamic pricing engine."
                       FontSize="13" Foreground="#475569"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,16,420">
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BoxShadow="0 4 12 0 #15000000">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="New Stadium" Command="{Binding NewCommand}"/>
                            <Button Classes="ghost"   Content="Edit"        Command="{Binding EditCommand}"/>
                            <Button Classes="danger"  Content="Delete"      Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Stadiums}"
                              SelectedItem="{Binding SelectedStadium}"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"     Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="City"     Binding="{Binding City}" Width="160"/>
                            <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="Ticket"   Binding="{Binding TicketPrice, StringFormat=0.00}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    BoxShadow="0 4 12 0 #15000000">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Stadium Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding !IsEditing}"
                                Spacing="6">
                        <TextBlock Text="{Binding SelectedStadium.Name, FallbackValue='No stadium selected'}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedStadium.City}" Foreground="#475569"/>
                        <TextBlock>
                            <Run Text="Capacity: "/>
                            <Run Text="{Binding SelectedStadium.Capacity, StringFormat=N0}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Base Ticket Price: "/>
                            <Run Text="{Binding SelectedStadium.TicketPrice, StringFormat=0.00}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding IsEditing}"
                                Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Name" FontSize="12" Foreground="#475569"/>
                            <TextBox Text="{Binding Draft.Name}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="City" FontSize="12" Foreground="#475569"/>
                            <TextBox Text="{Binding Draft.City}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Capacity" FontSize="12" Foreground="#475569"/>
                                <NumericUpDown Value="{Binding Draft.Capacity}" Minimum="0" Maximum="200000" Increment="500"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ticket Price" FontSize="12" Foreground="#475569"/>
                                <NumericUpDown Value="{Binding Draft.TicketPrice}" Minimum="0" Maximum="10000" Increment="1"
                                               FormatString="0.00"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Classes="primary" Content="Save"   Command="{Binding SaveCommand}"/>
                            <Button Classes="ghost"   Content="Cancel" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
