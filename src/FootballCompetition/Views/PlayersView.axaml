<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FootballCompetition.ViewModels"
             xmlns:m="using:FootballCompetition.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="FootballCompetition.Views.PlayersView"
             x:DataType="vm:PlayersViewModel">

    <Grid RowDefinitions="Auto,*" Margin="32,28">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Игроки" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Добавление и редактирование записей игроков. Каждый игрок должен принадлежать команде."
                       FontSize="13" Foreground="#475569"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,16,420">
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BoxShadow="0 4 12 0 #15000000">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="Добавить" Command="{Binding NewCommand}"/>
                            <Button Classes="ghost"   Content="Редактировать"
                                    Command="{Binding EditCommand}"
                                    IsEnabled="{Binding CanEditOrDelete}"/>
                            <Button Classes="danger"  Content="Удалить"
                                    Command="{Binding DeleteCommand}"
                                    IsEnabled="{Binding CanEditOrDelete}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Players}"
                              SelectedItem="{Binding SelectedPlayer}"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"          Binding="{Binding Number}"   Width="60"/>
                            <DataGridTextColumn Header="Полное имя"  Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Роль"       Binding="{Binding Role}"     Width="140"/>
                            <DataGridTextColumn Header="Возраст"        Binding="{Binding Age}"      Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    BoxShadow="0 4 12 0 #15000000">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Детали игрока"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding !IsEditing}"
                                Spacing="6">
                        <TextBlock Text="{Binding SelectedPlayer.FullName, FallbackValue='Игрок не выбран'}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock>
                            <Run Text="#"/>
                            <Run Text="{Binding SelectedPlayer.Number}"/>
                            <Run Text="  •  "/>
                            <Run Text="{Binding SelectedPlayer.Role}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Возраст: "/>
                            <Run Text="{Binding SelectedPlayer.Age}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Команда: "/>
                            <Run Text="{Binding SelectedTeam.Name, FallbackValue='—'}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding IsEditing}"
                                Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Команда" FontSize="12" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding Teams}"
                                      SelectedItem="{Binding SelectedTeam}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Team">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Полное имя" FontSize="12" Foreground="#475569"/>
                            <TextBox Text="{Binding Draft.FullName}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Роль" FontSize="12" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding Draft.Role}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Номер" FontSize="12" Foreground="#475569"/>
                                <NumericUpDown Value="{Binding Draft.Number}" Minimum="0" Maximum="99" Increment="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Возраст" FontSize="12" Foreground="#475569"/>
                                <NumericUpDown Value="{Binding Draft.Age}" Minimum="14" Maximum="60" Increment="1"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Classes="primary" Content="Сохранить"   Command="{Binding SaveCommand}"/>
                            <Button Classes="ghost"   Content="Отмена" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
